<div class="admin-header">
  <div>
    <h1>Test Prompt: <%= @prompt.name %></h1>
    <p class="text-muted">Test your prompt with real AI providers</p>
  </div>
</div>

<div class="card">
  <div class="card__header">
    <h3 class="card__title">Playground Settings</h3>
  </div>
  <div class="card__body">
    <%= form_with url: playground_prompt_path(@prompt), method: :post, local: true, html: { class: "form", multipart: true } do |form| %>
      <div class="form__group">
        <label class="form__label">AI Configuration</label>
        <div class="ai-config-display">
          <div class="ai-config-item">
            <strong>Provider:</strong> 
            <span class="provider-badge provider-badge--<%= @provider %>">
              <%= @provider&.capitalize || 'Not configured' %>
            </span>
          </div>
          <div class="ai-config-item">
            <strong>Model:</strong> 
            <span class="model-name">
              <% if @model_info %>
                <%= @model_info[:name] %>
                <code class="model-code"><%= @model_info[:value] %></code>
              <% elsif @prompt.model.present? %>
                <%= @prompt.model %>
              <% else %>
                <span class="text-muted">Not configured</span>
              <% end %>
            </span>
          </div>
          <% if @model_info&.dig(:description).present? %>
            <div class="ai-config-item">
              <strong>Description:</strong> 
              <span class="model-description"><%= @model_info[:description] %></span>
            </div>
          <% end %>
        </div>
        <div class="form__help">
          <% if @prompt.model.present? %>
            This prompt is configured to use the <%= @provider&.capitalize %> provider with the <%= @model_info&.dig(:name) || @prompt.model %> model.
          <% else %>
            This prompt doesn't have a model configured. Please <%= link_to "edit the prompt", edit_prompt_path(@prompt), class: "link" %> to set a model.
          <% end %>
        </div>
      </div>

      <div class="form__group">
        <%= form.label :api_key, "API Key", class: "form__label form__label--required" %>
        <% 
          # Get the appropriate API key based on determined provider
          default_api_key = nil
          api_key_configured = false
          
          if @provider == "anthropic" && @settings.anthropic_configured?
            default_api_key = @settings.anthropic_api_key
            api_key_configured = true
          elsif @provider == "openai" && @settings.openai_configured?
            default_api_key = @settings.openai_api_key
            api_key_configured = true
          end
        %>
        <%= form.password_field :api_key, 
            class: "form__input", 
            required: true,
            value: default_api_key,
            placeholder: api_key_configured ? "Using saved API key" : "Enter your API key",
            data: { 
              anthropic_key: @settings.anthropic_api_key,
              openai_key: @settings.openai_api_key
            } %>
        <div class="form__help">
          <% if api_key_configured %>
            Using saved API key from settings. <%= link_to "Change in settings", edit_settings_path, class: "link" %>
          <% else %>
            Your API key will not be stored. <%= link_to "Save in settings", edit_settings_path, class: "link" %>
          <% end %>
        </div>
      </div>

      <% if @parameters.any? %>
        <h3 class="form__section-title">Prompt Parameters</h3>
        <div class="form__help mb-md">Fill in the values for each parameter:</div>
        
        <% @parameters.each do |parameter_name| %>
          <% parameter = @prompt.parameters.find_by(name: parameter_name) %>
          <div class="form__group">
            <%= form.label "parameters[#{parameter_name}]", parameter_name.humanize.titleize, class: "form__label" %>
            <% if parameter&.parameter_type == 'file' %>
              <%= form.file_field "files[]", 
                  class: "form__input",
                  accept: ".pdf,.jpg,.jpeg,.png,.gif,.webp",
                  multiple: false %>
              <div class="form__help">Upload a file (PDF, JPG, PNG, GIF, WebP)</div>
            <% else %>
              <%= form.text_area "parameters[#{parameter_name}]", 
                  class: "form__textarea",
                  rows: 3,
                  placeholder: "Enter value for #{parameter_name}" %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <div class="form__actions">
        <%= link_to "Cancel", prompt_path(@prompt), class: "btn btn--secondary btn--medium" %>
        <%= form.submit "Test Prompt", class: "btn btn--primary btn--medium" %>
      </div>
    <% end %>
  </div>
</div>

<style>
  .ai-config-display {
    background-color: var(--color-gray-50);
    border: 1px solid var(--color-gray-200);
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 0.5rem;
  }
  
  .ai-config-item {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  
  .ai-config-item:last-child {
    margin-bottom: 0;
  }
  
  .ai-config-item strong {
    min-width: 80px;
    font-size: 0.875rem;
    color: var(--color-gray-700);
  }
  
  .provider-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
  }
  
  .provider-badge--anthropic {
    background-color: #fef3c7;
    color: #92400e;
    border: 1px solid #fbbf24;
  }
  
  .provider-badge--openai {
    background-color: #dbeafe;
    color: #1e40af;
    border: 1px solid #3b82f6;
  }
  
  .model-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .model-code {
    background-color: var(--color-gray-100);
    color: var(--color-gray-600);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
  }
  
  .model-description {
    color: var(--color-gray-600);
    font-size: 0.875rem;
    font-style: italic;
  }
</style>
